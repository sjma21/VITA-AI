# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres (matches docker-compose.yml defaults)
# Host port 5433 avoids clashing with a local Postgres on 5432
DATABASE_URL="postgresql://vita:vita@localhost:5433/vita?schema=public"

# Chat LLM — primary: Anthropic Claude (with retries), fallback: Google Gemini
# Get Claude key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-4-5
# How many Claude attempts before switching to Gemini (default 3)
LLM_CLAUDE_MAX_ATTEMPTS=3

# Gemini fallback (used when Claude fails / quota / errors after retries)
# Get a key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional alias for the same key:
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Embeddings via OpenRouter (Phase 1+)
# Free model: nvidia/nemotron-3-embed-1b:free (2048 dims)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_DIMENSIONS=2048

# Optional: still supported if you later prefer OpenAI embeddings
OPENAI_API_KEY=

# GitHub read-only token (Phase 1 ingest + tools)
GITHUB_TOKEN=
GITHUB_USERNAME=sjma21

# Protects /api/ingest/* (send as x-ingest-secret header)
INGEST_SECRET=dev-ingest-secret

# Admin inbox at /admin (password cookie session)
ADMIN_PASSWORD=dev-admin-password

# Meeting requests (Book a call) — emails go to OWNER_EMAIL
OWNER_EMAIL=sajalmishra361@gmail.com
# Get a key at https://resend.com
RESEND_API_KEY=
# Must be a Resend-verified domain. Do NOT use @gmail.com as From.
# Testing: onboarding@resend.dev (can send to your Resend account email)
RESEND_FROM_EMAIL=Vita <onboarding@resend.dev>
