# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres (matches docker-compose.yml defaults)
# Host port 5433 avoids clashing with a local Postgres on 5432
DATABASE_URL="postgresql://vita:vita@localhost:5433/vita?schema=public"

# Chat LLM (Phase 2) — Anthropic Claude
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-4-5

# Embeddings via OpenRouter (Phase 1+)
# Free model: nvidia/nemotron-3-embed-1b:free (2048 dims)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_DIMENSIONS=2048

# Optional: still supported if you later prefer OpenAI embeddings
OPENAI_API_KEY=

# GitHub read-only token (Phase 1 ingest + tools)
GITHUB_TOKEN=
GITHUB_USERNAME=sjma21

# Protects /api/ingest/* (send as x-ingest-secret header)
INGEST_SECRET=dev-ingest-secret

# Optional admin gate (Phase 4)
ADMIN_PASSWORD=
